{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@effect-ui/core": ["./packages/core/src/index.ts"],
      "@effect-ui/db": ["./packages/db/src/index.ts"],
      "@effect-ui/react": ["./packages/react/src/index.ts"],
      "@effect-ui/react-db": ["./packages/react-db/src/index.ts"],
      "@effect-ui/solid": ["./packages/solid/src/index.ts"],
      "@effect-ui/solid-db": ["./packages/solid-db/src/index.ts"],
      "@effect-ui/tsrx": ["./packages/tsrx/src/index.ts"],
      "@effect-ui/start": ["./packages/start/src/index.ts"],
      "@effect-ui/start/adapters": ["./packages/start/src/adapters.ts"],
      "@effect-ui/start/cli": ["./packages/start/src/cli.ts"],
      "@effect-ui/start/fetch-adapter": ["./packages/start/src/fetch-adapter.ts"],
      "@effect-ui/start/node-adapter": ["./packages/start/src/node-adapter.ts"],
      "@effect-ui/start/diagnostics-report": ["./packages/start/src/diagnostics-report.ts"],
      "@effect-ui/start-node": ["./packages/start-node/src/index.ts"],
      "@effect-ui/start-fetch": ["./packages/start-fetch/src/index.ts"],
      "@effect-ui/start/virtual": ["./packages/start/src/virtual-modules.d.ts"],
      "@effect-ui/start/vite": ["./packages/start/src/vite.ts"],
      "@effect-ui/devtools": ["./packages/devtools/src/index.ts"]
    }
  }
}
