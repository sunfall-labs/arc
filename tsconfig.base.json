{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@sunfall/arc-core": ["./packages/core/src/index.ts"],
      "@sunfall/arc-db": ["./packages/db/src/index.ts"],
      "@sunfall/arc-react": ["./packages/react/src/index.ts"],
      "@sunfall/arc-react-db": ["./packages/react-db/src/index.ts"],
      "@sunfall/arc-solid": ["./packages/solid/src/index.ts"],
      "@sunfall/arc-solid-db": ["./packages/solid-db/src/index.ts"],
      "@sunfall/arc-tsrx": ["./packages/tsrx/src/index.ts"],
      "@sunfall/arc-start": ["./packages/start/src/index.ts"],
      "@sunfall/arc-start/adapters": ["./packages/start/src/adapters.ts"],
      "@sunfall/arc-start/cli": ["./packages/start/src/cli.ts"],
      "@sunfall/arc-start/fetch-adapter": ["./packages/start/src/fetch-adapter.ts"],
      "@sunfall/arc-start/node-adapter": ["./packages/start/src/node-adapter.ts"],
      "@sunfall/arc-start/diagnostics-report": ["./packages/start/src/diagnostics-report.ts"],
      "@sunfall/arc-start-node": ["./packages/start-node/src/index.ts"],
      "@sunfall/arc-start-fetch": ["./packages/start-fetch/src/index.ts"],
      "@sunfall/arc-start/virtual": ["./packages/start/src/virtual-modules.d.ts"],
      "@sunfall/arc-start/vite": ["./packages/start/src/vite.ts"],
      "@sunfall/arc-devtools": ["./packages/devtools/src/index.ts"]
    }
  }
}
