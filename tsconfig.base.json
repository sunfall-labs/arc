{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@sunfall/arc-core": ["./packages/core/src/index.ts"],
      "@sunfall/arc-core/internal": ["./packages/core/src/internal.ts"],
      "@sunfall/arc-db": ["./packages/db/src/index.ts"],
      "@sunfall/arc-db/internal": ["./packages/db/src/internal.ts"],
      "@sunfall/arc-solid": ["./packages/solid/src/index.ts"],
      "@sunfall/arc-solid-db": ["./packages/solid-db/src/index.ts"],
      "@sunfall/arc-tsrx": ["./packages/tsrx/src/index.ts"],
      "@sunfall/arc-start": ["./packages/start/src/index.ts"],
      "@sunfall/arc-start/fetch": ["./packages/start/src/fetch.ts"],
      "@sunfall/arc-start/node": ["./packages/start/src/node.ts"],
      "@sunfall/arc-start/diagnostics-report": ["./packages/start/src/diagnostics-report.ts"],
      "@sunfall/arc-start/internal": ["./packages/start/src/internal.ts"],
      "@sunfall/arc-start/testing": ["./packages/start/src/testing.ts"],
      "@sunfall/arc-start/virtual": ["./packages/start/src/virtual-modules.d.ts"],
      "@sunfall/arc-start/vite": ["./packages/start/src/vite.ts"],
      "@sunfall/arc-devtools": ["./packages/devtools/src/index.ts"]
    },
    "types": ["node"]
  }
}
