  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -b tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.66"
  }
}
