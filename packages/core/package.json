{
  "name": "@effect-ui/core",
  "version": "0.0.0-alpha.0",
  "description": "Effect-first UI runtime primitives for resources, actions, routes, forms, capabilities, and server contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
