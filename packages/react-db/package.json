{
  "name": "@sunfall/arc-react-db",
  "version": "0.0.0-alpha.0",
  "description": "React bindings for Sunfall Arc collections and live queries.",
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-db": "workspace:*",
    "@sunfall/arc-react": "workspace:*",
    "effect": "^4.0.0-beta.66"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <21"
  }
}
