{
  "name": "@sunfall/arc-devtools",
  "version": "0.1.0-alpha.1",
  "description": "Serializable Sunfall Arc devtools snapshots, summaries, causal graphs, traces, and panel rendering.",
  "keywords": [
    "devtools",
    "diagnostics",
    "effect",
    "framework",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/arc#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/arc/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/arc.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@sunfall/arc-core": "workspace:*",
    "effect": "^4.0.0-beta.66"
  }
}
