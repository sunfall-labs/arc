{
  "name": "@effect-ui/start-fetch",
  "version": "0.0.0-alpha.0",
  "description": "Fetch-host facade for the tested Effect UI Start adapter surface.",
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@effect-ui/start": "workspace:*"
  }
}
