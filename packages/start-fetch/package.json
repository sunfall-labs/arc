{
  "name": "@sunfall/arc-start-fetch",
  "version": "0.1.0-alpha.0",
  "description": "Fetch-host facade for the tested Sunfall Arc Start adapter surface.",
  "keywords": [
    "effect",
    "fetch",
    "framework",
    "ssr",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/arc#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/arc/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/arc.git",
    "directory": "packages/start-fetch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@sunfall/arc-start": "workspace:*"
  }
}
