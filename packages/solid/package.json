{
  "name": "@effect-ui/solid",
  "version": "0.0.0-alpha.0",
  "description": "Solid runtime provider, router, resource, action, stream, and scope bindings for Effect UI.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
