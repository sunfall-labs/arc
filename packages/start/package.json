{
  "name": "@effect-ui/start",
  "version": "0.0.0-alpha.0",
  "description": "Effect UI full-stack Start layer for SSR, hydration, transports, diagnostics, and app graphs.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "effect-ui-start": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./diagnostics-report": {
      "types": "./dist/diagnostics-report.d.ts",
      "default": "./dist/diagnostics-report.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./fetch-adapter": {
      "types": "./dist/fetch-adapter.d.ts",
      "default": "./dist/fetch-adapter.js"
    },
    "./node-adapter": {
      "types": "./dist/node-adapter.d.ts",
      "default": "./dist/node-adapter.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./dist/virtual.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json && cp src/virtual-modules.d.ts dist/virtual.d.ts && rm -f dist/virtual.d.ts.map",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@effect-ui/core": "workspace:*",
    "@effect-ui/db": "workspace:*",
    "effect": "^4.0.0-beta.66"
  },
  "peerDependencies": {
    "vite": "*"
  }
}
