{
  "name": "@sunfall/arc-start",
  "version": "0.1.0-alpha.1",
  "description": "Sunfall Arc full-stack Start layer for SSR, hydration, transports, and file routes.",
  "keywords": [
    "effect",
    "framework",
    "ssr",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/sunfall-labs/arc#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/arc/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/arc.git",
    "directory": "packages/start"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./dist/virtual.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json && cp src/virtual-modules.d.ts dist/virtual.d.ts && rm -f dist/virtual.d.ts.map",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-solid": "workspace:*",
    "effect": "4.0.3"
  },
  "peerDependencies": {
    "vite": "*"
  }
}
