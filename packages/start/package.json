{
  "name": "@sunfall/arc-start",
  "version": "0.1.0-alpha.1",
  "description": "Sunfall Arc full-stack Start layer for SSR, hydration, transports, diagnostics, and app graphs.",
  "keywords": [
    "effect",
    "framework",
    "ssr",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/sunfall-labs/arc#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/arc/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/arc.git",
    "directory": "packages/start"
  },
  "bin": {
    "sunfall-arc-start": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./diagnostics-report": {
      "types": "./dist/diagnostics-report.d.ts",
      "default": "./dist/diagnostics-report.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./fetch-adapter": {
      "types": "./dist/fetch-adapter.d.ts",
      "default": "./dist/fetch-adapter.js"
    },
    "./node-adapter": {
      "types": "./dist/node-adapter.d.ts",
      "default": "./dist/node-adapter.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "default": "./dist/virtual.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json && cp src/virtual-modules.d.ts dist/virtual.d.ts && rm -f dist/virtual.d.ts.map && chmod +x dist/cli.js",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-db": "workspace:*",
    "effect": "^4.0.0-beta.66"
  },
  "peerDependencies": {
    "vite": "*"
  }
}
