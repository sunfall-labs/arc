{
  "name": "@effect-ui/db",
  "version": "0.0.0-alpha.0",
  "description": "Effect UI local-first collections, live queries, persistence, and sync adapters.",
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@effect-ui/core": "workspace:*",
    "@tanstack/db-ivm": "0.1.18",
    "effect": "^4.0.0-beta.66"
  }
}
