{
  "name": "@sunfall/arc-db",
  "version": "0.1.0-alpha.1",
  "description": "Sunfall Arc local-first collections, live queries, persistence, and sync adapters.",
  "keywords": [
    "collections",
    "effect",
    "live-query",
    "local-first",
    "typescript"
  ],
  "homepage": "https://github.com/sunfall-labs/arc#readme",
  "bugs": {
    "url": "https://github.com/sunfall-labs/arc/issues"
  },
  "license": "MIT",
  "author": "Andrew Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfall-labs/arc.git",
    "directory": "packages/db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@sunfall/arc-core": "workspace:*",
    "@tanstack/db-ivm": "0.1.18",
    "effect": "^4.0.0-beta.66"
  }
}
