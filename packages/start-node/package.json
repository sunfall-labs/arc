{
  "name": "@effect-ui/start-node",
  "version": "0.0.0-alpha.0",
  "description": "Node HTTP facade for the tested Effect UI Start adapter surface.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsgo -p tsconfig.json",
    "typecheck": "tsgo -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@effect-ui/start": "workspace:*"
  }
}
