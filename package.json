{
  "name": "effect-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "example:build": "pnpm --filter @effect-ui/example-project-console build",
    "example:dev": "pnpm --filter @effect-ui/example-project-console dev",
    "example:leak-scan": "! rg \"seedProjects|Move invoice preview|Webhook replay|domain\\\\.server\" examples/project-console/dist -n",
    "example:test": "vitest run examples/project-console/src/*.test.ts",
    "example:typecheck": "pnpm --filter @effect-ui/example-project-console typecheck",
    "test": "vitest run",
    "typecheck": "tsgo -b tsconfig.json --pretty false && pnpm typecheck:types",
    "typecheck:types": "tsgo -p tsconfig.type-tests.json --noEmit --pretty false",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm example:typecheck && pnpm example:test && pnpm example:build && pnpm example:leak-scan"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.66"
  },
  "devDependencies": {
    "@tsrx/solid": "0.1.8",
    "@tsrx/typescript-plugin": "^0.3.58",
    "@tsrx/vite-plugin-solid": "0.0.37",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  }
}
