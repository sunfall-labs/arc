{
  "name": "@effect-ui/starter-react",
  "version": "0.0.0-alpha.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "README.md",
    "components.json",
    "index.html",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/*.test.ts",
    "leak-scan": "! rg \"starter\\.server|/src/starter\\.server\\.ts\" dist -n",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm leak-scan"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@effect-ui/core": "workspace:*",
    "@effect-ui/react": "workspace:*",
    "@effect-ui/start": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.0-beta.66",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
