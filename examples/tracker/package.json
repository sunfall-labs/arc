{
  "name": "@sunfall/arc-example-tracker",
  "version": "0.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    ".gitignore",
    "FRICTION.md",
    "README.md",
    "index.html",
    "scripts",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsrx-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsrx-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/*.test.ts",
    "leak-scan": "node scripts/leak-scan.mjs",
    "start": "node dist/server/index.js",
    "smoke": "node scripts/production-smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm leak-scan && pnpm smoke"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.3",
    "@solidjs/web": "2.0.0-rc.14",
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-solid": "workspace:*",
    "@sunfall/arc-start": "workspace:*",
    "@sunfall/arc-tsrx": "workspace:*",
    "effect": "4.0.3",
    "solid-js": "2.0.0-rc.14"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^25.7.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "sunfallArcLeakScan": {
    "dist": "dist/client",
    "patterns": [
      "\\.server\\.(?:ts|js)",
      "sql-sqlite-node",
      "node:sqlite",
      "DatabaseSync",
      "CREATE TABLE",
      "seedIssues",
      "sessionCookieName",
      "Draft the onboarding checklist"
    ]
  }
}
