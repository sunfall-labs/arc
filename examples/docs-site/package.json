{
  "name": "@sunfall/arc-example-docs-site",
  "version": "0.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    ".gitignore",
    "README.md",
    "index.html",
    "public",
    "scripts",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsrx-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsrx-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/*.test.ts",
    "leak-scan": "node scripts/leak-scan.mjs",
    "pages:verify": "node scripts/verify-pages-build.mjs",
    "pages:smoke": "node scripts/smoke-pages-build.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm leak-scan"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-solid": "workspace:*",
    "@sunfall/arc-start": "workspace:*",
    "@sunfall/arc-tsrx": "workspace:*",
    "effect": "4.0.3",
    "solid-js": "2.0.0-rc.14"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^25.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "sunfallArcLeakScan": {
    "dist": "dist",
    "patterns": [
      "content\\.server",
      "/src/content\\.server\\.ts",
      "readRecipeFileEffect",
      "@shikijs/",
      "\\bshiki/(?:core|engine|langs|themes)\\b",
      "\\bnode:fs\\b"
    ]
  }
}
