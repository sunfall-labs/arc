{
  "name": "@sunfall/arc-example-docs-site",
  "version": "0.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "author": "Andrew Lee",
  "files": [
    ".gitignore",
    "README.md",
    "index.html",
    "scripts",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsrx-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsrx-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/*.test.ts",
    "leak-scan": "node scripts/leak-scan.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm leak-scan"
  },
  "dependencies": {
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@sunfall/arc-core": "workspace:*",
    "@sunfall/arc-solid": "workspace:*",
    "@sunfall/arc-start": "workspace:*",
    "@sunfall/arc-tsrx": "workspace:*",
    "effect": "^4.0.0-beta.66",
    "shiki": "^4.0.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tsrx/typescript-plugin": "^0.3.58",
    "@types/node": "^25.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "sunfallArcLeakScan": {
    "dist": "dist",
    "patterns": [
      "content\\.server",
      "/src/content\\.server\\.ts",
      "readRecipeFileEffect"
    ]
  }
}
